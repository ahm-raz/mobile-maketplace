# Supabase (same project as the shared marketplace backend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Main marketplace API (REST) — local: http://localhost:3000 while `npm run dev` runs at repo root
NEXT_PUBLIC_API_URL=

# Skip Supabase cookie refresh in middleware (e.g. Playwright without env)
# SKIP_SUPABASE_MIDDLEWARE=1

# Local full stack (copy to `.env.local`):
# 1. Repo root: npm run supabase:start   (Docker Desktop must be healthy)
# 2. Terminal A (repo root): npm run dev           → API on :3000
# 3. Terminal B (repo root): npm run dev:mobile   → mobile UI on :3001
# Use `npx supabase status` for URL/keys if defaults in `.env.local` fail after a CLI upgrade.
