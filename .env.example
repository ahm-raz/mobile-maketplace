# Supabase (see https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Local Supabase (after `npm run supabase:start` — requires Docker Desktop; run `npx supabase status` for keys)
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from supabase status>
# SUPABASE_SERVICE_ROLE_KEY=<service_role key from supabase status>

# Payment webhook — POST /api/webhooks/payment (Bearer or X-Payment-Webhook-Secret)
PAYMENT_WEBHOOK_SECRET=

# Optional — distributed rate limiting (EU). Falls back to in-memory if unset.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
