# See https://help.github.com/articles/ignoring-files/

# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js / production bundles
.next/
out/
build/
dist/

# Testing
coverage/
.nyc_output/
playwright-report/
test-results/
**/__e2e__/.playwright/

# Vitest / Vite
*.vitest-temp/

# Environment (do not commit secrets)
!.env.example

# Vercel / deploy
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI local state (under supabase/)
supabase/.branches
supabase/.temp

# Storybook
storybook-static/
*storybook.log

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Turborepo / caches (if used)
.turbo/

# OS & editors
.DS_Store
Thumbs.db
*.pem
*.swp
*.swo

# Optional local scratch files
__tmp_*.json
config.bat
